# Copy to .env.local and fill in what you have. Every integration below is
# optional — the site builds and runs fully without any of them, using
# graceful no-op fallbacks. See README.md "Going live" for setup notes.

# Supabase — powers the future CMS/admin panel, comments, and guestbook.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary — image/video hosting and optimization for uploaded media.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend — newsletter subscriptions and the contact form.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
CONTACT_EMAIL=

# PostHog — product analytics.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
